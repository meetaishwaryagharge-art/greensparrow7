rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function clean(d) {
      return d.status == 'new' && d.createdAt == request.time &&
             d.name.size() <= 120 && d.email.size() <= 160;
    }

    // Public website may only CREATE. Only admins can read / edit / delete.
    match /enquiries/{id} {
      allow create: if clean(request.resource.data)
        && request.resource.data.keys().hasOnly(['form','name','company','email','phone','services','budget','timeline','details','page','status','createdAt'])
        && request.resource.data.keys().hasAll(['name','email','phone','services','details'])
        && request.resource.data.details.size() <= 3000;
      allow read, update, delete: if isAdmin();
    }
    match /consultations/{id} {
      allow create: if clean(request.resource.data)
        && request.resource.data.keys().hasOnly(['form','name','phone','email','topic','date','time','mode','message','page','status','createdAt'])
        && request.resource.data.keys().hasAll(['name','phone','email','topic','date','time'])
        && (!('message' in request.resource.data) || request.resource.data.message.size() <= 3000);
      allow read, update, delete: if isAdmin();
    }
    match /messages/{id} {
      allow create: if clean(request.resource.data)
        && request.resource.data.keys().hasOnly(['form','name','phone','email','service','message','page','status','createdAt'])
        && request.resource.data.keys().hasAll(['name','email','message'])
        && request.resource.data.message.size() <= 3000;
      allow read, update, delete: if isAdmin();
    }
    match /subscribers/{id} {
      allow create: if request.resource.data.status == 'new' && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly(['email','page','status','createdAt'])
        && request.resource.data.email.size() <= 160;
      allow read, update, delete: if isAdmin();
    }
    // Admin allow-list: create docs manually in the console (doc id = user UID).
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
